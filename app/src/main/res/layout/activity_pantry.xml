<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:fitsSystemWindows="true">

    <!-- Pantry screen heading -->
    <TextView
        android:id="@+id/pantryTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Pantry"
        android:textSize="28sp"
        android:textStyle="bold"
        android:paddingBottom="12dp" />

    <!-- Pantry items are displayed here -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/pantryRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="8dp">

        <!-- Pantry Button -->
        <Button
            android:id="@+id/pantryNavigationButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Pantry"
            android:layout_margin="6dp" />

        <!-- Button for adding a new ingredient -->
        <Button
            android:id="@+id/addIngredientButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Add Ingredient"
            android:layout_margin="6dp" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="8dp">

        <!-- Button for suggested recipes -->
        <Button
            android:id="@+id/suggestedRecipesButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Suggested Recipes"
            android:layout_margin="6dp" />

        <Button
            android:id="@+id/settingsNavigationButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Settings"
            android:layout_margin="6dp" />

    </LinearLayout>

</LinearLayout>